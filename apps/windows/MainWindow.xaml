<Window x:Class="BlueBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BlueBridge.Windows.Models"
        Title="BlueBridge" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Ink}">
            <Grid Margin="22,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="BlueBridge" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="音频路由" Background="White" Foreground="{StaticResource Ink}" HorizontalContentAlignment="Left" Margin="0,0,0,7" />
                    <Button Content="设备" Background="Transparent" Foreground="#8F8F8B" HorizontalContentAlignment="Left" Margin="0,0,0,7" />
                    <Button Content="场景" Background="Transparent" Foreground="#8F8F8B" HorizontalContentAlignment="Left" Margin="0,0,0,7" />
                    <Button Content="设置" Background="Transparent" Foreground="#8F8F8B" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="仅在本地处理" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="音频不会上传到云端" Foreground="#7A7A77" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,30,34,42">
                <DockPanel Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="音频路由" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="16" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Status}" Margin="0,0,7,0" /><TextBlock Text="{Binding RouteStatus}" FontSize="11" /></StackPanel>
                    </Border>
                </DockPanel>

                <Border Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="当前路由" Foreground="{StaticResource Muted}" FontSize="11" />
                                <TextBlock Text="{Binding RouteName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Click="ToggleRoute_Click" Background="{StaticResource Ink}" Foreground="White" MinWidth="76" />
                        </DockPanel>

                        <Grid Margin="0,22,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Canvas}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="01  来源" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="Pixel 9 · 媒体" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                            <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="{StaticResource Canvas}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="02  目标" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="本机 Windows" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                            <TextBlock Grid.Column="3" Text="→" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Column="4" Background="{StaticResource Canvas}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="03  输出" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="2.4G 耳机" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                        </Grid>

                        <Separator Background="{StaticResource Divider}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="标准蓝牙" FontSize="11" Margin="0,0,26,0" />
                            <TextBlock Text="18 ms" FontSize="11" Margin="0,0,26,0" />
                            <TextBlock Text="48 kHz · 24 bit" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="新建路由" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="选择来源、目标和输出设备" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,15" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="音频来源" FontSize="10" Foreground="{StaticResource Muted}" /><ComboBox SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem>Pixel 9 · 媒体</ComboBoxItem><ComboBoxItem>本机 · 游戏</ComboBoxItem></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="目标设备" FontSize="10" Foreground="{StaticResource Muted}" /><ComboBox SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem>本机 Windows</ComboBoxItem><ComboBoxItem>Pixel 9</ComboBoxItem></ComboBox></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="输出设备" FontSize="10" Foreground="{StaticResource Muted}" /><ComboBox SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem>2.4G 耳机</ComboBoxItem><ComboBoxItem>USB DAC</ComboBoxItem></ComboBox></StackPanel>
                            <Button Grid.Column="6" Content="启动" Click="StartGaming_Click" Background="{StaticResource Ink}" Foreground="White" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="混音" FontSize="17" FontWeight="SemiBold" Margin="0,25,0,11" />
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MixerSource}">
                            <Border Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                                    <Slider Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="18,0" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsMuted}" Content="静音" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="可信设备" FontSize="17" FontWeight="SemiBold" Margin="0,25,0,11" />
                <Border Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="10">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="16,13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Grid.Column="2" Text="在线" Foreground="{StaticResource Status}" FontSize="10" HorizontalAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="场景" FontSize="17" FontWeight="SemiBold" Margin="0,25,0,11" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="StartGaming_Click" Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="游戏 + 学习" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="手机 → Windows → 2.4G 耳机" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Button>
                    <Button Grid.Column="2" Click="StartLibrary_Click" Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="1" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="图书馆" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="Mac → Android → 蓝牙耳机" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
